# Environment Variables - Growth Engine Frontend

# JWT Secret (change in production!)
JWT_SECRET=dev-secret-key-for-3day-mvp-demo

# API Configuration
# NEXT_PUBLIC_API_URL is used by frontend API client to connect to backend
# Development: http://localhost:4000/api/v1
# Production: https://api.growth-engine.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Development Notes:
# - Copy this file to .env.local for local development
# - Never commit .env.local to git
# - OpenAI configuration is now in backend package only
